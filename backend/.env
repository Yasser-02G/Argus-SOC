# Base de données
DATABASE_URL=postgresql+asyncpg://argus:argus@db:5432/argus

# Collecteur syslog
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
SYSLOG_HOST=0.0.0.0

# API
API_HOST=0.0.0.0
API_PORT=8000

# Agent IA — clé gratuite sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# Rapports PDF
REPORTS_DIR=/app/data/reports
ENABLE_SCHEDULED_REPORTS=true
